---
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";
import CartBadge from "@/theme/components/cart/CartBadge.astro";
import Logo from "@/theme/components/brand/Logo.astro";

interface Props {
  config: StoreConfig;
  content?: StoreFrontContent;
}
const { config, content } = Astro.props;

const links = content
  ? [
      { href: "/#features", label: content.navFeatures },
      { href: "/#demo", label: content.navDemo },
      { href: "/#pricing", label: content.navPricing },
      { href: "/products", label: content.navProducts },
      { href: "/#faq", label: content.navFaq },
    ]
  : [];
---

<header class="dx-header" data-dx-header style="padding-top: var(--safe-top)">
  <div class="dx-container dx-header__bar relative">
    <Logo config={config} uid="header" />

    <nav class="hidden lg:flex items-center gap-1" aria-label={content?.ariaMainNavigation}>
      {links.map((link) => <a href={link.href} class="dx-nav-link">{link.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      {content && (
        <>
          <a href="/#demo" class="dx-btn dx-btn--ghost hidden md:inline-flex" data-demo-open>{content.heroCtaSecondary}</a>
          <a href="/#pricing" class="dx-btn dx-btn--primary dx-btn--sm sm:!h-10 sm:!px-4">{content.heroCtaPrimary}</a>
        </>
      )}
      {config.cartEnabled && content && <CartBadge content={content} />}
      {content && (
        <button
          type="button"
          class="dx-menu-btn lg:hidden"
          aria-expanded="false"
          aria-controls="dx-mobile-menu"
          aria-label={content.navMenuOpen}
          data-label-open={content.navMenuOpen}
          data-label-close={content.navMenuClose}
          data-menu-toggle
        >
          <Icon name="heroicons:bars-3" data-icon-open aria-hidden="true" />
          <Icon name="heroicons:x-mark" data-icon-close style="display: none" aria-hidden="true" />
        </button>
      )}
    </div>
  </div>

  {content && (
    <div id="dx-mobile-menu" class="dx-mobile-menu absolute inset-x-0 top-full lg:hidden" style="display: none" data-mobile-menu>
      <nav class="dx-container pb-6 pt-2" aria-label={content.ariaMainNavigation}>
        {links.map((link) => (
          <a href={link.href} class="dx-mobile-menu__link" data-menu-link>
            {link.label}
            <Icon name="heroicons:chevron-right" class="dx-flip" aria-hidden="true" />
          </a>
        ))}
        <div class="mt-6 grid gap-3">
          <a href="/#pricing" class="dx-btn dx-btn--primary dx-btn--lg dx-btn--block" data-menu-link>{content.heroCtaPrimary}</a>
          <a href="/#demo" class="dx-btn dx-btn--secondary dx-btn--lg dx-btn--block" data-menu-link data-demo-open>
            <span class="dx-btn__play" aria-hidden="true"><Icon name="heroicons:play" /></span>
            {content.heroCtaSecondary}
          </a>
        </div>
        <p class="dx-small mt-5 flex items-center justify-center gap-2 text-center">
          <Icon name="heroicons:shield-check" class="h-4 w-4 shrink-0" style="color: var(--clr-accent-strong)" aria-hidden="true" />
          {content.footerPayNote}
        </p>
      </nav>
    </div>
  )}
</header>

<script>
  import "@/theme/scripts/site-header";
</script>
