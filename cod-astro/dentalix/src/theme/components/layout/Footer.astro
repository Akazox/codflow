---
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";
import Logo from "@/theme/components/brand/Logo.astro";

interface Props {
  config: StoreConfig;
  content?: StoreFrontContent;
}
const { config, content } = Astro.props;
const year = new Date().getFullYear();

const productLinks = content
  ? [
      { href: "/#features", label: content.navFeatures },
      { href: "/#demo", label: content.navDemo },
      { href: "/#how", label: content.howKicker },
      { href: "/#faq", label: content.navFaq },
    ]
  : [];
const offerLinks = content
  ? [
      { href: "/#pricing", label: content.navPricing },
      { href: "/products", label: content.allProductsSection },
    ]
  : [];
const pages = config.pages ?? [];
---

<footer class="dx-footer">
  <div class="dx-container py-14 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Logo config={config} uid="footer" />
        {content?.footerAbout && (
          <p class="dx-body mt-4 max-w-sm">{content.footerAbout}</p>
        )}
        {content?.footerPayNote && (
          <p class="dx-chip dx-chip--accent mt-5 !h-8 !px-3 !text-[0.8125rem]">
            <Icon name="heroicons:shield-check" aria-hidden="true" />
            {content.footerPayNote}
          </p>
        )}
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
        {productLinks.length > 0 && (
          <div>
            <h3 class="dx-footer__title">{content?.footerQuickLinks}</h3>
            <ul class="space-y-3">
              {productLinks.map((link) => <li><a href={link.href} class="dx-footer__link">{link.label}</a></li>)}
            </ul>
          </div>
        )}
        {offerLinks.length > 0 && (
          <div>
            <h3 class="dx-footer__title">{content?.navProducts}</h3>
            <ul class="space-y-3">
              {offerLinks.map((link) => <li><a href={link.href} class="dx-footer__link">{link.label}</a></li>)}
            </ul>
          </div>
        )}
        {pages.length > 0 && (
          <div class="col-span-2 sm:col-span-1">
            <h3 class="dx-footer__title">{content?.footerSupport}</h3>
            <ul class="space-y-3">
              {pages.map((page) => (
                <li><a href={`/pages/${page.slug}`} class="dx-footer__link">{page.title}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t pt-6 sm:flex-row sm:items-center sm:justify-between" style="border-color: var(--clr-border)">
      <p class="dx-small">&copy; {year} {config.name}. {content?.footerRights}</p>
      {content?.brandTagline && <p class="dx-small">{content.brandTagline}</p>}
    </div>
  </div>
</footer>
