---
import { Icon } from "astro-icon/components";
import HeroVisual from "./HeroVisual.astro";
import type { StoreFrontContent } from "@/theme/content";

interface Props {
  content: StoreFrontContent;
  currency: string;
  isRTL: boolean;
}

const { content, currency, isRTL } = Astro.props;
const trust = [content.trust1Title, content.trust2Title, content.trust3Title].filter(Boolean);
---

<section class="dx-hero" aria-labelledby="hero-title">
  <div class="dx-hero__grid-bg" aria-hidden="true"></div>
  <div class="dx-container relative">
    <div class="mx-auto max-w-3xl text-center">
      {content.heroEyebrow && (
        <p class="dx-eyebrow dx-reveal">
          {content.heroEyebrowTag && <span class="dx-eyebrow__dot">{content.heroEyebrowTag}</span>}
          {content.heroEyebrow}
        </p>
      )}
      <h1 id="hero-title" class="dx-h1 mt-6 dx-reveal" style="animation-delay: 60ms">
        {content.heroTitle}
        {content.heroTitleAccent && (
          <>
            {" "}<span class="dx-gradient-text">{content.heroTitleAccent}</span>
          </>
        )}
      </h1>
      <p class="dx-lead mx-auto mt-6 max-w-2xl dx-reveal" style="animation-delay: 120ms">{content.heroSubtitle}</p>

      <div class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center dx-reveal" style="animation-delay: 180ms">
        <a href="#pricing" class="dx-btn dx-btn--primary dx-btn--lg">
          {content.heroCtaPrimary}
          <Icon name="heroicons:arrow-right" class:list={[isRTL && "dx-flip"]} aria-hidden="true" />
        </a>
        <a href="#demo" class="dx-btn dx-btn--secondary dx-btn--lg" data-demo-open>
          <span class="dx-btn__play" aria-hidden="true"><Icon name="heroicons:play" /></span>
          {content.heroCtaSecondary}
        </a>
      </div>

      {trust.length > 0 && (
        <ul class="dx-trust-row mt-8 justify-center dx-reveal" style="animation-delay: 240ms">
          {trust.map((item) => (
            <li><Icon name="heroicons:check-circle" aria-hidden="true" />{item}</li>
          ))}
        </ul>
      )}
    </div>

    <div class="mt-14 lg:mt-16">
      <HeroVisual content={content} currency={currency} />
    </div>
  </div>
</section>
