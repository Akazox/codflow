---
import { Icon } from "astro-icon/components";
import type { StoreFrontContent } from "@/theme/content";

interface Props {
  content: StoreFrontContent;
}

const { content: c } = Astro.props;
const steps = [
  { icon: "heroicons:document-check", title: c.howStep1Title, sub: c.howStep1Sub },
  { icon: "heroicons:phone", title: c.howStep2Title, sub: c.howStep2Sub },
  { icon: "heroicons:academic-cap", title: c.howStep3Title, sub: c.howStep3Sub },
  { icon: "heroicons:rocket-launch", title: c.howStep4Title, sub: c.howStep4Sub },
].filter((s) => s.title);
---

<section id="how" class="dx-section dx-section--alt" aria-labelledby="how-title">
  <div class="dx-container">
    <div class="dx-section-head">
      <span class="dx-kicker">{c.howKicker}</span>
      <h2 id="how-title" class="dx-h2">{c.howItWorksTitle}</h2>
      <p class="dx-lead mt-5">{c.howItWorksSub}</p>
    </div>

    <ol class="dx-steps">
      {steps.map((step, i) => (
        <li class:list={["dx-step", i === steps.length - 1 && "dx-step--final"]}>
          <span class="dx-step__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="dx-icon-tile"><Icon name={step.icon} aria-hidden="true" /></span>
          <h3 class="dx-step__title">{step.title}</h3>
          <p class="dx-step__sub">{step.sub}</p>
        </li>
      ))}
    </ol>

    {c.howPaymentNote && (
      <p class="dx-pay-note mx-auto max-w-3xl justify-center text-center">
        <Icon name="heroicons:banknotes" aria-hidden="true" />
        {c.howPaymentNote}
      </p>
    )}
  </div>
</section>
