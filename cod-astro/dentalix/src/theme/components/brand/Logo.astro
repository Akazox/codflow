---
import { Image } from "astro:assets";
import type { StoreConfig } from "@/core/api/types";

interface Props {
  config: StoreConfig;
  /** Unique per instance so two logos on one page never share a gradient id. */
  uid?: string;
  class?: string;
  href?: string;
}

const { config, uid = "hd", class: className, href = "/" } = Astro.props;
const gradientId = `dx-logo-grad-${uid}`;
---

<a href={href} class:list={["dx-logo", className]} aria-label={config.name}>
  {config.logoUrl ? (
    <Image
      src={config.logoUrl}
      alt={config.name}
      width={160}
      height={40}
      format="webp"
      quality={90}
      class="h-8 w-auto object-contain"
      loading="eager"
      decoding="async"
    />
  ) : (
    <>
      <svg class="dx-logo__mark" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" style="stop-color: var(--clr-accent)" />
            <stop offset="1" style="stop-color: var(--clr-primary)" />
          </linearGradient>
        </defs>
        <rect width="32" height="32" rx="9" fill={`url(#${gradientId})`} />
        <path
          d="M16 9.3c-1.1-.9-2.4-1.5-3.9-1.5-2.7 0-4.5 2.1-4.5 4.8 0 2 .8 3.4 1.4 5 .6 1.7.8 3.8 1.4 5.6.4 1.2 1 1.8 1.7 1.8 1.1 0 1.5-1.1 1.8-2.6.3-1.7.8-3.4 2.1-3.4s1.8 1.7 2.1 3.4c.3 1.5.7 2.6 1.8 2.6.7 0 1.3-.6 1.7-1.8.6-1.8.8-3.9 1.4-5.6.6-1.6 1.4-3 1.4-5 0-2.7-1.8-4.8-4.5-4.8-1.5 0-2.8.6-3.9 1.5z"
          style="fill: var(--clr-surface)"
        />
        <path d="M12.4 12.2c.9-.7 2.3-.7 3.6.2" style="stroke: var(--clr-accent); fill: none" stroke-width="1.4" stroke-linecap="round" />
      </svg>
      <span class="dx-logo__word">{config.name}</span>
    </>
  )}
</a>
