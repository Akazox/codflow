---
// No ClientRouter / view transitions: they broke module-script MIME types on
// the deployed Worker (see THEME_GUIDE.md). Full page loads only.
//
// Akalya owns its palette and type (styles/global.css). Unlike theme01, the
// dashboard's primary/accent/bg colours and font are NOT injected here.

import { DEFAULT_CONFIG } from "@/theme/config/store";
import { MEDIA_DOMAIN } from "astro:env/server";

interface Props {
  title: string;
  description: string;
  ogImage: string;
  noindex?: boolean;
  config: any;
  /** The page's LCP images (landing page stack top, home hero) — preloaded. */
  preloadImages?: string[];
}

const { title, description, ogImage, noindex, config, preloadImages } = Astro.props;

const isArabic = config.lang === "ar";
const OG_LOCALES: Record<string, string> = { ar: "ar_DZ", fr: "fr_DZ", en: "en_US" };
const ogLocale = OG_LOCALES[config.lang] ?? "fr_DZ";

// Fraunces (display) + Jost (text) for Latin; Amiri (display) + Tajawal (text)
// are added only for an Arabic storefront, so French/English pages never
// download Arabic fonts they do not render.
const LATIN_FAMILIES = "family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Jost:wght@300..600";
const ARABIC_FAMILIES = "&family=Amiri:wght@400;700&family=Tajawal:wght@400;500;700";
const fontHref = `https://fonts.googleapis.com/css2?${LATIN_FAMILIES}${isArabic ? ARABIC_FAMILIES : ""}&display=swap`;
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content={DEFAULT_CONFIG.bgColor} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <link rel="canonical" href={Astro.url.href} />
  <meta name="author" content={config.name} />

  <meta property="og:title" content={title} />
  <meta property="og:site_name" content={config.name} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:description" content={description} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={ogLocale} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontHref} rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href={fontHref} rel="stylesheet" /></noscript>

  {MEDIA_DOMAIN && <link rel="preconnect" href={`https://${MEDIA_DOMAIN}`} />}

  {/* Only the first preload is high priority: deeper images would compete
      with the LCP for mobile bandwidth. */}
  {preloadImages?.slice(0, 2).map((src, i) => (
    <link rel="preload" as="image" href={src} fetchpriority={i === 0 ? "high" : undefined} />
  ))}

  {/* Meta Pixel — canonical base code, unmodified. fbevents.js buffers every
      fbq() call made before it loads; do not defer or custom-load it. */}
  {config.pixelId && (
    <Fragment>
      <script type="text/javascript" set:html={`
!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '${config.pixelId}');
fbq('track', 'PageView');
      `} />
      <noscript>
        <img height="1" width="1" style="display:none"
          src={`https://www.facebook.com/tr?id=${config.pixelId}&ev=PageView&noscript=1`}
          alt=""
        />
      </noscript>
    </Fragment>
  )}

  <style set:html={`
    *, *::before, *::after { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html { scroll-behavior: smooth; height: -webkit-fill-available; }
    body { margin: 0; min-height: 100vh; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
  `} />
</head>
