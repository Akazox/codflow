---
/**
 * Header cart trigger.
 *
 * Ships hidden and is revealed by the controller, so a browser without JS or
 * with storage blocked shows no control that cannot work. Once the cart is
 * available the trigger stays put whether or not the basket has anything in
 * it — an icon that materialises only after the first add reads as a glitch,
 * and a cart nobody can see is a cart nobody uses.
 *
 * Only the count bubble comes and goes. The count is filled in by the client,
 * so this markup is safe to serve from the edge cache. `aria-live` announces
 * changes for screen readers without stealing focus.
 */
import type { StoreFrontContent } from "@/theme/content";

interface Props {
  content: StoreFrontContent;
}

const { content } = Astro.props;
---

<button
  type="button"
  id="cart-badge"
  hidden
  aria-label={content.cartOpenLabel}
  aria-controls="cart-drawer"
  aria-expanded="false"
  class="akl-icon-btn relative -me-2.5 active:scale-[0.94]"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5.2 8.5h13.6l-1 11.2a1.5 1.5 0 0 1-1.5 1.3H7.7a1.5 1.5 0 0 1-1.5-1.3L5.2 8.5Z" />
    <path d="M8.75 8.5V7a3.25 3.25 0 0 1 6.5 0v1.5" />
  </svg>
  <span
    id="cart-badge-count"
    hidden
    aria-live="polite"
    class="absolute top-1 end-0.5 min-w-[1.15rem] h-[1.15rem] rounded-full px-1 text-[0.625rem] font-medium leading-[1.15rem] text-center tabular"
    style="background: var(--clr-primary); color: var(--clr-on-primary)">0</span
  >
</button>
