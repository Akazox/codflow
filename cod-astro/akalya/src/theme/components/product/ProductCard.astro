---
/**
 * Product card — calm, image-first (4:5 on warm stone), serif name, one line
 * of what it is, price. The whole card is one link (the title's stretched
 * ::after); a simple, in-stock product also gets a round quick-add when the
 * merchant has the cart on. Products with variants link to their page, where
 * the shopper picks a size first.
 */
import { Image } from "astro:assets";
import type { Product } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import AddToCartButton from "@/theme/components/cart/AddToCartButton.astro";
import StarRow from "@/theme/components/ui/StarRow.astro";
import { productImageSource } from "@/theme/utils/product-image";
import { getThumbnailImage } from "@/core/utils/image-optimizer";
import { formatPrice, discountPercent } from "@/theme/utils/format";

interface Props {
  product: Product;
  currencySymbol?: string;
  eager?: boolean;
  content?: StoreFrontContent;
  /** The store's cart switch — enables the quick-add on simple products. */
  cartEnabled?: boolean;
  /** Heading level for the product name inside its section. */
  headingLevel?: "h2" | "h3";
}

const { product, currencySymbol = "", eager = false, content, cartEnabled = false, headingLevel = "h3" } = Astro.props;

const image = product.coverImage ?? product.images?.[0];
const pct = discountPercent(product.price, product.compareAtPrice);
const isOutOfStock = product.trackInventory && product.inventory === 0;
const isLowStock = product.trackInventory && product.inventory > 0 && product.inventory <= 5;
const href = `/products/${product.handle}`;
const summary = product.descriptionPlain ?? (product.descriptionFormat !== "html" ? product.description : null);
const quickAdd = cartEnabled && content && !product.hasVariants && !isOutOfStock;
const thumbSrc = productImageSource(product);
const Heading = headingLevel;
const ariaLabel = content?.ariaProductCard
  ?.replace("{name}", product.name)
  ?.replace("{price}", formatPrice(product.price))
  ?.replace("{currency}", currencySymbol) ?? product.name;
---

<article class="pcard">
  <div class="pcard-media">
    {image ? (
      <Image
        src={image.src}
        alt={image.altText ?? product.name}
        width={480}
        height={600}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        format="webp"
        quality={85}
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center" aria-hidden="true">
        <svg viewBox="0 0 100 125" class="w-1/3 opacity-30" style="color: var(--clr-primary)"><path d="M10 125V80A50 50 0 1 1 90 80V125" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      </div>
    )}

    {pct > 0 && !isOutOfStock && (
      <span class="akl-badge absolute top-3 start-3 tabular" aria-hidden="true">−{pct}%</span>
    )}

    {isOutOfStock && content && (
      <div class="pcard-soldout" aria-hidden="true">
        <span class="akl-badge akl-badge-dark">{content.outOfStock}</span>
      </div>
    )}

    {quickAdd && content && (
      <div class="pcard-quick">
        <AddToCartButton
          compact={true}
          product={product}
          content={content}
          basePrice={product.price}
          image={thumbSrc ? getThumbnailImage(thumbSrc) : null}
        />
      </div>
    )}
  </div>

  <div class="flex flex-col gap-1.5 pt-3.5 pe-1">
    <Heading class="pcard-title">
      <a href={href} data-astro-prefetch="hover" aria-label={ariaLabel}>{product.name}</a>
    </Heading>
    {summary && (
      <p class="t-small line-clamp-2">{summary}</p>
    )}
    {product.reviewStats && product.reviewStats.reviewCount > 0 && content && (
      <div class="flex items-center gap-1.5">
        <StarRow rating={product.reviewStats.avgRating} label={content.ariaRatingOutOf.replace("{n}", String(product.reviewStats.avgRating))} />
        <span class="text-[0.75rem] tabular" style="color: var(--clr-text-2)">({product.reviewStats.reviewCount})</span>
      </div>
    )}
    <p class="flex flex-wrap items-baseline gap-x-2 mt-0.5">
      <span class="t-price text-[0.9375rem]">{formatPrice(product.price)} {currencySymbol}</span>
      {pct > 0 && (
        <span class="t-compare text-[0.8125rem] tabular">{formatPrice(product.compareAtPrice!)} {currencySymbol}</span>
      )}
    </p>
    {isLowStock && content && (
      <p class="text-[0.75rem] font-medium" style="color: var(--clr-primary-ink)">
        {content.lowStock.replace("{n}", String(product.inventory))}
      </p>
    )}
  </div>
</article>
