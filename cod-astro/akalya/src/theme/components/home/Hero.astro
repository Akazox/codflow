---
/**
 * Editorial hero: serif headline with an accent line, and the merchant's
 * featured product framed in a horseshoe arch — the Maghreb signature — with
 * a hairline arch offset behind it and a small price label. A second product
 * sits in a round arch on larger screens. With no product photo at all, the
 * arch holds an ingredient drawing instead of an empty box.
 */
import { Icon } from "astro-icon/components";
import type { StoreFrontContent } from "@/theme/config/content";
import Ornament from "@/theme/components/ui/Ornament.astro";
import { formatPrice } from "@/theme/utils/format";

interface Props {
  content: StoreFrontContent;
  currencySymbol: string;
  /** Featured product + its (already optimised) image URL. */
  product?: { name: string; handle: string; price: number } | null;
  imageSrc?: string | null;
  secondary?: { name: string; handle: string } | null;
  secondaryImageSrc?: string | null;
}

const { content, currencySymbol, product = null, imageSrc = null, secondary = null, secondaryImageSrc = null } = Astro.props;
---

<section class="akl-glow akl-grain overflow-hidden">
  <div class="akl-container grid items-center gap-12 pt-10 pb-16 sm:pt-14 lg:grid-cols-12 lg:gap-8 lg:pt-16 lg:pb-24">
    <div class="lg:col-span-6 xl:col-span-5 relative z-[1]">
      <p class="t-eyebrow akl-rise">
        <Ornament name="star" class="w-2 h-2 akl-ornament" />
        {content.heroEyebrow}
      </p>
      <h1 class="t-display-xl mt-5 akl-rise-2">
        {content.heroTitle}
        {content.heroTitleAccent && (
          <span class="t-accent block">{content.heroTitleAccent}</span>
        )}
      </h1>
      <p class="t-lede mt-6 max-w-[30rem] akl-rise-3">{content.heroSubtitle}</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-5 akl-rise-4">
        <a href="/products" class="btn-primary btn-auto btn-lg">
          {content.heroCtaPrimary}
          <Icon name="heroicons:arrow-right" class="flip-rtl" />
        </a>
        <a href="#rituel" class="link-arrow">{content.heroCtaSecondary}</a>
      </div>
    </div>

    <div class="lg:col-span-6 xl:col-span-7 relative">
      <div class="relative mx-auto w-[82%] max-w-[25rem] lg:max-w-[27rem] lg:me-[12%] xl:me-[18%]">
        <Ornament name="arch" class="absolute -top-4 -bottom-4 -start-4 -end-4 w-[calc(100%+2rem)] h-[calc(100%+2rem)] akl-ornament opacity-60 pointer-events-none" />

        {product ? (
          <a href={`/products/${product.handle}`} class="relative block aspect-[4/5] akl-horseshoe" style="background: var(--clr-surface-alt)" aria-label={product.name}>
            {imageSrc ? (
              <img
                src={imageSrc}
                alt={product.name}
                width="720"
                height="900"
                class="absolute inset-0 w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <span class="absolute inset-0 flex items-center justify-center akl-ornament">
                <Ornament name="argan" class="w-1/2" />
              </span>
            )}
          </a>
        ) : (
          <div class="relative aspect-[4/5] akl-horseshoe flex items-center justify-center akl-ornament" style="background: var(--clr-surface-alt)">
            <Ornament name="argan" class="w-1/2" />
          </div>
        )}

        <Ornament name="sprig" class="absolute -top-3 end-[-1.25rem] w-12 h-12 akl-ornament opacity-80 hidden sm:block" />

        {product && (
          <a
            href={`/products/${product.handle}`}
            class="absolute bottom-6 -start-6 sm:-start-12 max-w-[15rem] rounded-[var(--radius-card)] px-4 py-3.5 shadow-[var(--shadow-md)] transition-transform hover:-translate-y-0.5"
            style="background: var(--clr-surface); border: 1px solid var(--clr-border)"
          >
            <span class="t-eyebrow text-[0.625rem]">{content.heroProductLabel}</span>
            <span class="block font-display text-[1.0625rem] leading-snug mt-1" style="color: var(--clr-text)">{product.name}</span>
            <span class="t-price block text-[0.875rem] mt-1">{formatPrice(product.price)} {currencySymbol}</span>
          </a>
        )}

        {secondary && secondaryImageSrc && (
          <a
            href={`/products/${secondary.handle}`}
            class="hidden md:block absolute -bottom-10 -end-24 w-40 aspect-[3/4] akl-arch"
            style="background: var(--clr-surface-alt); outline: 6px solid var(--clr-bg)"
            aria-label={secondary.name}
          >
            <img src={secondaryImageSrc} alt={secondary.name} width="320" height="427" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </a>
        )}
      </div>
    </div>
  </div>
</section>
