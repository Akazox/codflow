---
import "@/theme/styles/global.css";
import BaseHead from "@/theme/components/layout/BaseHead.astro";
import Header from "@/theme/components/layout/Header.astro";
import Footer from "@/theme/components/layout/Footer.astro";
import CartDrawer from "@/theme/components/cart/CartDrawer.astro";
import WhatsAppWidget from "@/theme/components/chat/WhatsAppWidget.astro";
import Ornament from "@/theme/components/ui/Ornament.astro";
import { showsWidgetOn } from "@/theme/utils/shows-widget-on";
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { DEFAULT_CONFIG } from "@/theme/config/store";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  config?: StoreConfig;
  content?: StoreFrontContent;
  /** Marketing mode (landing pages): no announcement bar, header, footer or
   *  cart — the page brings its own slim branded bar and minimal footer. */
  marketing?: boolean;
  /** LCP images — preloaded in <head>. */
  preloadImages?: string[];
}

const { title, description, ogImage, noindex, config: c, content, marketing = false, preloadImages } = Astro.props;
const config = c ?? DEFAULT_CONFIG;

const isRTL = config.lang === "ar";
const pageTitle = title ?? config.metaTitle ?? config.name;
const pageDesc = description ?? config.metaDescription ?? (content?.defaultMetaDescription?.replace("{storeName}", config.name) ?? config.name);
const pageOg = ogImage ?? config.ogImage ?? "";
const announcement = config.announcementBar ?? content?.announcementText;
---

<!doctype html>
<html lang={config.lang} dir={isRTL ? "rtl" : "ltr"}>
  <BaseHead
    title={pageTitle}
    description={pageDesc}
    ogImage={pageOg}
    noindex={noindex}
    config={config}
    preloadImages={preloadImages}
  />

  <body>
    {content && <a href="#main" class="skip-link">{content.skipToContent}</a>}

    {!marketing && announcement && (
      <div class="store-announce">
        <Ornament name="star" />
        <span>{announcement}</span>
        <Ornament name="star" class="hidden sm:block" />
      </div>
    )}

    {!marketing && <Header config={config} content={content} />}

    <main id="main">
      <slot />
    </main>

    {!marketing && <Footer config={config} content={content} />}

    {/* One drawer per page, outside the main flow so its fixed positioning is
        never trapped by a transformed ancestor. Rendered only when the cart is
        on: a merchant who never enabled it ships none of this markup. */}
    {!marketing && config.cartEnabled && content && (
      <>
        <CartDrawer content={content} currency={config.currencySymbol} />
        {/* Imported for its side effect: the module self-initialises. */}
        <script>
          import "@/theme/scripts/cart-ui";
        </script>
      </>
    )}

    {/* WhatsApp chat widget — only when configured and enabled on this surface.
        The thank-you page shows an inline button instead. */}
    {config.whatsapp && content && showsWidgetOn(config.whatsapp.surfaces, Astro.url.pathname) && Astro.url.pathname !== "/thank-you" && (
      <>
        <WhatsAppWidget widget={config.whatsapp} content={content} config={config} />
        <script>
          import "@/theme/scripts/whatsapp-widget";
        </script>
      </>
    )}
  </body>
</html>
