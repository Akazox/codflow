---
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";
import Wordmark from "./Wordmark.astro";

interface Props {
  config: StoreConfig;
  content?: StoreFrontContent;
}
const { config, content } = Astro.props;
const year = new Date().getFullYear();

const trust = content
  ? [
      { icon: "heroicons:banknotes", title: content.trust1Title, sub: content.trust1Sub },
      { icon: "heroicons:truck", title: content.trust2Title, sub: content.trust2Sub },
      { icon: "heroicons:photo", title: content.trust3Title, sub: content.trust3Sub },
      { icon: "heroicons:arrow-path", title: content.trust4Title, sub: content.trust4Sub },
    ]
  : [];

const explore = [
  { label: content?.navHome, href: "/" },
  { label: content?.navGallery, href: "/products" },
  { label: content?.navCollections, href: "/#collections" },
  { label: content?.navNewArrivals, href: "/#new-arrivals" },
  { label: content?.navHowToOrder, href: "/#how-to-order" },
];

const contact = config.legalContact;
const hasContact = !!(contact && (contact.contactPhone || contact.contactEmail));
---

<footer class="wd-footer">
  <div class="wd-container">
    {trust.length > 0 && (
      <div class="wd-footer-trust">
        {trust.map((item) => (
          <div class="wd-footer-trust-item">
            <Icon name={item.icon} aria-hidden="true" />
            <div>
              <strong>{item.title}</strong>
              <span>{item.sub}</span>
            </div>
          </div>
        ))}
      </div>
    )}

    <div class="grid gap-10 py-12 md:grid-cols-12 md:gap-8 lg:py-16">
      <div class="md:col-span-5 space-y-4">
        <Wordmark config={config} />
        <p class="max-w-sm leading-relaxed">{content?.footerAbout}</p>
      </div>

      <div class="md:col-span-7 grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <h3 class="wd-footer-title">{content?.footerQuickLinks}</h3>
          <ul class="space-y-2.5">
            {explore.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>

        {config.pages.length > 0 && (
          <div>
            <h3 class="wd-footer-title">{content?.footerLegal}</h3>
            <ul class="space-y-2.5">
              {config.pages.map((page) => (
                <li><a href={`/pages/${page.slug}`}>{page.title}</a></li>
              ))}
            </ul>
          </div>
        )}

        {hasContact && (
          <div>
            <h3 class="wd-footer-title">{content?.footerContact}</h3>
            <ul class="space-y-2.5">
              {contact!.contactPhone && (
                <li><a href={`tel:${contact!.contactPhone}`} dir="ltr">{contact!.contactPhone}</a></li>
              )}
              {contact!.contactEmail && (
                <li><a href={`mailto:${contact!.contactEmail}`} class="break-all">{contact!.contactEmail}</a></li>
              )}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="wd-footer-bottom">
    <div class="wd-container flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {config.name}. {content?.footerRights}</p>
      <p>{content?.trust1Title} · {content?.trust2Title}</p>
    </div>
  </div>
</footer>
