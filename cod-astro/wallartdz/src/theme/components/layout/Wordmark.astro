---
import { Image } from "astro:assets";
import type { StoreConfig } from "@/core/api/types";

interface Props {
  config: StoreConfig;
  /** Render as plain markup instead of a link (landing pages keep shoppers in the funnel). */
  static?: boolean;
}

const { config, static: isStatic = false } = Astro.props;
const Tag = isStatic ? "span" : "a";
---

<Tag href={isStatic ? undefined : "/"} class="wd-wordmark" aria-label={isStatic ? undefined : config.name}>
  {config.logoUrl ? (
    <Image
      src={config.logoUrl}
      alt={config.name}
      width={180}
      height={48}
      format="webp"
      quality={90}
      class="wd-wordmark-logo"
      loading="eager"
      decoding="async"
    />
  ) : (
    <>
      <span class="wd-wordmark-mark" aria-hidden="true"></span>
      <span class="wd-wordmark-name" dir="ltr">{config.name}</span>
    </>
  )}
</Tag>
