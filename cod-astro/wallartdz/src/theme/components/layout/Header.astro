---
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";
import CartBadge from "@/theme/components/cart/CartBadge.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  config: StoreConfig;
  content?: StoreFrontContent;
}
const { config, content } = Astro.props;
const path = Astro.url.pathname;

const links = [
  { href: "/", label: content?.navHome, current: path === "/" },
  { href: "/#collections", label: content?.navCollections, current: false },
  { href: "/#new-arrivals", label: content?.navNewArrivals, current: false },
  { href: "/#how-to-order", label: content?.navHowToOrder, current: false },
];
const inGallery = path.startsWith("/products") || path.startsWith("/category");
---

<header class="wd-header">
  <div class="wd-container wd-header-inner">
    <Wordmark config={config} />

    <nav class="wd-nav" aria-label={content?.ariaMainNavigation}>
      {links.map((link) => (
        <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href="/products"
        class="wd-header-action"
        aria-current={inGallery ? "page" : undefined}
      >
        <Icon name="heroicons:squares-2x2" aria-hidden="true" />
        <span>{content?.navGallery}</span>
      </a>
      {config.cartEnabled && content && <CartBadge content={content} />}
    </div>
  </div>
</header>
