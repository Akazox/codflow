---
/**
 * Product gallery. Swipe track on phones (scroll-snap, dots driven by
 * product.ts), a calm vertical stack of every image on desktop. The DOM
 * contract product.ts reads is unchanged: #gallery, slides with
 * data-image-id, .gallery-dot buttons whose first child is the indicator.
 */
import { Image } from "astro:assets";
import type { Product } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";

interface Props {
  product: Product;
  hasDiscount: boolean;
  discountPct: number;
  content: StoreFrontContent;
}

const { product, hasDiscount, discountPct, content } = Astro.props;
const total = product.images.length;
---

<div class="wd-gallery">
  <div class="gallery-track" id="gallery">
    {total > 0 ? product.images.map((img, idx) => (
      <div class="gallery-slide" data-image-id={img.id}>
        {idx === 0 ? (
          <Image
            src={img.src}
            alt={img.altText ?? product.name}
            width={1000}
            height={1000}
            widths={[480, 800, 1000]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            priority={true}
            format="webp"
            quality={88}
          />
        ) : (
          <Image
            src={img.src}
            alt={img.altText ?? product.name}
            width={1000}
            height={1000}
            widths={[480, 800, 1000]}
            sizes="(min-width: 1024px) 55vw, 100vw"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={88}
          />
        )}
      </div>
    )) : (
      <div class="gallery-slide">
        <Icon name="heroicons:photo" class="w-16 h-16 opacity-20" aria-hidden="true" />
      </div>
    )}
  </div>

  {hasDiscount && (
    <span class="wd-gallery-tag" data-save-badge data-template={content.offerSaveBadge}>
      {content.offerSaveBadge.replace("{n}", String(discountPct))}
    </span>
  )}

  {total > 1 && (
    <div class="wd-gallery-dots" id="gallery-dots">
      {product.images.map((_, i) => (
        <button
          type="button"
          class="gallery-dot"
          aria-label={content.ariaGoToImage.replace("{n}", String(i + 1)).replace("{total}", String(total))}
          data-index={i}
        >
          <span style={i === 0 ? "width: 1.25rem; opacity: 1" : undefined}></span>
        </button>
      ))}
    </div>
  )}
</div>
