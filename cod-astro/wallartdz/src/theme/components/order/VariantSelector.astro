---
/**
 * Size / frame / any-option picker.
 *
 * Every button keeps the platform contract product.ts reads (`.variant-opt`
 * with data-option, data-value, data-first, data-oos) and adds what the
 * art preview needs: aria-pressed, data-kind and, for a frame, the finish it
 * names. A size is drawn as a rectangle at its true proportions; a frame as a
 * swatch of this artwork inside that frame.
 *
 * May be rendered twice on one page (above the fold and inside the order
 * card); product.ts keeps the two in step.
 */
import type { Product } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { optionKind, parseSize, frameKindOf } from "@/theme/utils/art-options";

interface Props {
  product: Product;
  content: StoreFrontContent;
  /** Smaller chips without size drawings — for the order card. */
  compact?: boolean;
  /** The artwork shown inside frame swatches. */
  swatchImage?: string | null;
}

const { product, content, compact = false, swatchImage = null } = Astro.props;

function isValueOos(optName: string, optValue: string): boolean {
  if (!product.trackInventory) return false;
  const matching = product.variants.filter((v) => v.variations[optName] === optValue);
  if (matching.length === 0) return false;
  return matching.every((v) => v.inventory === 0);
}

function firstInStockIdx(optName: string): number {
  if (!product.trackInventory) return 0;
  const opt = product.variantOptions?.find((o) => o.name === optName);
  if (!opt) return 0;
  const idx = opt.values.findIndex((v) => !isValueOos(optName, v.value));
  return idx >= 0 ? idx : 0;
}

const options = (product.variantOptions ?? []).map((opt) => {
  const kind = optionKind(opt);
  const defaultIdx = firstInStockIdx(opt.name);
  const sizes = opt.values.map((v) => parseSize(v.value));
  const maxDim = Math.max(1, ...sizes.flatMap((s) => (s ? [s.w, s.h] : [])));
  return {
    name: opt.name,
    kind,
    defaultValue: opt.values[defaultIdx]?.value ?? "",
    values: opt.values.map((val, vi) => {
      const size = sizes[vi];
      const frame = frameKindOf(val.value) ?? (val.hexColor ? "custom" : null);
      return {
        value: val.value,
        hexColor: val.hexColor ?? null,
        oos: isValueOos(opt.name, val.value),
        first: vi === defaultIdx,
        frame,
        shape: size ? `--sw: ${(size.w / maxDim).toFixed(3)}; --sh: ${(size.h / maxDim).toFixed(3)}` : null,
      };
    }),
  };
});

const groupId = (i: number) => `wd-opt-${compact ? "c" : "h"}-${i}`;
---

{product.hasVariants && options.length > 0 && product.variants.length > 0 && (
  <div class:list={["wd-variants", compact && "wd-variants--compact"]}>
    {options.map((opt, oi) => (
      <div role="group" aria-labelledby={groupId(oi)}>
        <div class="wd-opt-head">
          <span class="wd-opt-name" id={groupId(oi)}>{opt.name}</span>
          <span class="wd-opt-current">
            <span data-option-current={opt.name} dir={opt.kind === "size" ? "ltr" : undefined}>{opt.defaultValue}</span>
            {opt.kind === "size" && <span> {content.sizeUnit}</span>}
          </span>
        </div>
        <div class:list={["wd-opt-row", `wd-opt-row--${opt.kind}`]}>
          {opt.values.map((val) => (
            <button
              type="button"
              class="variant-opt wd-chip"
              data-option={opt.name}
              data-value={val.value}
              data-first={val.first && !val.oos ? "1" : ""}
              data-oos={val.oos ? "1" : ""}
              data-kind={opt.kind}
              data-frame-kind={opt.kind === "frame" && val.frame && val.frame !== "custom" ? val.frame : undefined}
              aria-pressed={val.first && !val.oos ? "true" : "false"}
              aria-disabled={val.oos ? "true" : undefined}
            >
              {opt.kind === "size" && val.shape && (
                <span class="wd-chip-shape-box" aria-hidden="true">
                  <span class="wd-chip-shape" style={val.shape}></span>
                </span>
              )}
              {opt.kind === "frame" && (
                <span
                  class="wd-swatch"
                  data-frame={val.frame ?? "none"}
                  style={[
                    swatchImage ? `background-image: url("${swatchImage}")` : "",
                    val.hexColor ? `--swatch: ${val.hexColor}` : "",
                  ].filter(Boolean).join("; ") || undefined}
                  aria-hidden="true"
                ></span>
              )}
              <span class="wd-chip-label" dir={opt.kind === "size" ? "ltr" : undefined}>{val.value}</span>
              {opt.kind === "size" && !compact && <span class="wd-chip-unit">{content.sizeUnit}</span>}
            </button>
          ))}
        </div>
      </div>
    ))}
  </div>
)}
