---
import "@/theme/styles/global.css";
import BaseHead from "@/theme/components/layout/BaseHead.astro";
import Header from "@/theme/components/layout/Header.astro";
import Footer from "@/theme/components/layout/Footer.astro";
import CartDrawer from "@/theme/components/cart/CartDrawer.astro";
import Wordmark from "@/theme/components/layout/Wordmark.astro";
import WhatsAppWidget from "@/theme/components/chat/WhatsAppWidget.astro";
import { showsWidgetOn } from "@/theme/utils/shows-widget-on";
import type { StoreConfig } from "@/core/api/types";
import type { StoreFrontContent } from "@/theme/config/content";
import { Icon } from "astro-icon/components";
import { DEFAULT_CONFIG } from "@/theme/config/store";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  config?: StoreConfig;
  content?: StoreFrontContent;
  /** Reserve room at the bottom of the page for the sticky order bar (mobile). */
  stickyBar?: boolean;
  /** Marketing mode (landing pages): no navigation and no store footer — a
   *  brand bar, the page itself, and the legal links Meta reviewers look for. */
  marketing?: boolean;
  /** LCP images (landing page stack top) — preloaded in <head>. */
  preloadImages?: string[];
}

const { title, description, ogImage, noindex, config: c, content, marketing = false, stickyBar = false, preloadImages } = Astro.props;
const config = c ?? DEFAULT_CONFIG;
const year = new Date().getFullYear();

const isRTL = config.lang === "ar";
const pageTitle = title ?? config.metaTitle ?? config.name;
const pageDesc = description ?? config.metaDescription ?? (content?.defaultMetaDescription?.replace("{storeName}", config.name) ?? `Shop from ${config.name}`);
const pageOg = ogImage ?? config.ogImage ?? "";

---

<!doctype html>
<html lang={config.lang} dir={isRTL ? "rtl" : "ltr"}>
  <BaseHead 
    title={pageTitle}
    description={pageDesc}
    ogImage={pageOg}
    noindex={noindex}
    config={config}
    preloadImages={preloadImages}
  />

  <body class:list={[stickyBar && "has-sticky-bar"]}>
    {(config.announcementBar || content?.announcementText) && (
      <div class="store-announce">
        <Icon name="heroicons:truck" aria-hidden="true" />
        <span>{config.announcementBar ?? content?.announcementText}</span>
      </div>
    )}

    {marketing ? (
      <div class="wd-lp-bar"><Wordmark config={config} static={true} /></div>
    ) : (
      <Header config={config} content={content} />
    )}

    <main>
      <slot />
    </main>

    {marketing ? (
      <footer class="wd-footer">
        <div class="wd-footer-bottom">
          <div class="wd-container flex flex-col items-center gap-2 text-center">
            {config.pages.length > 0 && (
              <nav class="flex flex-wrap justify-center gap-x-4 gap-y-1" aria-label={content?.footerLegal}>
                {config.pages.map((page) => <a href={`/pages/${page.slug}`}>{page.title}</a>)}
              </nav>
            )}
            <p>&copy; {year} {config.name}. {content?.footerRights}</p>
          </div>
        </div>
      </footer>
    ) : (
      <Footer config={config} content={content} />
    )}

    {/* One drawer per page, outside the main flow so its fixed positioning is
        never trapped by a transformed ancestor. Rendered only when the cart is
        on: a merchant who never enabled it ships none of this markup. */}
    {config.cartEnabled && content && (
      <>
        <CartDrawer content={content} currency={config.currencySymbol} />
        {/* Imported for its side effect: the module self-initialises on
            DOMContentLoaded, the same pattern product.ts uses. Calling
            initCart() here as well used to bind every handler twice. */}
        <script>
          import "@/theme/scripts/cart-ui";
        </script>
      </>
    )}

    {/* WhatsApp Chat Widget — merchant-configurable contact handoff.
        Rendered only when configured, non-null, and enabled on the current surface. 
        EXCEPTION: On thank-you page, we show an inline button instead of the floating widget. */}
    {config.whatsapp && content && showsWidgetOn(config.whatsapp.surfaces, Astro.url.pathname) && Astro.url.pathname !== "/thank-you" && (
      <>
        <WhatsAppWidget widget={config.whatsapp} content={content} config={config} />
        {/* Imported for side effect: self-initialises on DOM ready */}
        <script>
          import "@/theme/scripts/whatsapp-widget";
        </script>
      </>
    )}

  </body>
</html>
